<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <PropertyGroup>
        <!-- 
          1591: Отсутствует XML-комментарий
          1573: Пропущен конкретный параметр в комментарии
          1574: Не найдена ссылка в cref
          1712: Пропущен generic-параметр в комментарии
          NU1903: Предупреждение об известной уязвимости с высоким уровнем серьезности (SSH.NET)
        -->
        <NoWarn>$(NoWarn);1591;1573;1574;1712;NU1903</NoWarn>
    </PropertyGroup>
</Project>
